# ── Normalisation des fins de ligne ───────────────────────────────────────
* text=auto eol=lf

# Formats texte de Godot : versionnés en clair, diffables, mergeables.
# Ils fusionnent MAL en pratique (structure positionnelle) — d'où la règle
# « une scène, un propriétaire à la fois » dans CONTRIBUTING.md.
*.tscn   text eol=lf
*.tres   text eol=lf
*.godot  text eol=lf
*.cfg    text eol=lf
*.gd     text eol=lf
*.md     text eol=lf
*.json   text eol=lf

# ── Git LFS ───────────────────────────────────────────────────────────────
# Tout binaire volumineux. Configuré AVANT le premier asset : migrer un
# historique déjà pollué demande une réécriture complète des commits.
#
# `lockable` rend ces fichiers lecture seule tant qu'un verrou n'est pas posé
# (`git lfs lock <fichier>`). C'est ce qui empêche deux personnes de modifier
# le même modèle en parallèle — un binaire ne fusionne pas.

# Modèles 3D
*.glb    filter=lfs diff=lfs merge=lfs -text lockable
*.gltf   filter=lfs diff=lfs merge=lfs -text lockable
*.fbx    filter=lfs diff=lfs merge=lfs -text lockable
*.obj    filter=lfs diff=lfs merge=lfs -text lockable
*.blend  filter=lfs diff=lfs merge=lfs -text lockable
*.blend1 filter=lfs diff=lfs merge=lfs -text lockable

# Textures & images
*.png    filter=lfs diff=lfs merge=lfs -text lockable
*.jpg    filter=lfs diff=lfs merge=lfs -text lockable
*.jpeg   filter=lfs diff=lfs merge=lfs -text lockable
*.tga    filter=lfs diff=lfs merge=lfs -text lockable
*.psd    filter=lfs diff=lfs merge=lfs -text lockable
*.exr    filter=lfs diff=lfs merge=lfs -text lockable
*.hdr    filter=lfs diff=lfs merge=lfs -text lockable

# Audio
*.wav    filter=lfs diff=lfs merge=lfs -text lockable
*.ogg    filter=lfs diff=lfs merge=lfs -text lockable
*.mp3    filter=lfs diff=lfs merge=lfs -text lockable

# Vidéo & polices
*.ogv    filter=lfs diff=lfs merge=lfs -text lockable
*.ttf    filter=lfs diff=lfs merge=lfs -text lockable
*.otf    filter=lfs diff=lfs merge=lfs -text lockable
