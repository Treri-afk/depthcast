# ── Godot 4 ───────────────────────────────────────────────────────────────
# Cache et données locales du moteur : régénérés à l'ouverture du projet.
.godot/
/android/

# Anciennes versions de Godot (3.x) — inoffensif de le garder.
.import/

# ── Exports & builds ──────────────────────────────────────────────────────
/build/
/builds/
/exports/
*.pck
*.zip

# ── Extensions tierces ────────────────────────────────────────────────────
# GodotSteam s'installe par l'AssetLib, machine par machine (D18) : plusieurs
# dizaines de Mo de binaires par plateforme, quand le dépôt n'a qu'1 Go de LFS
# par mois. Rien de ce que fait la CI n'en a besoin — voir docs/STEAM.md.
/addons/godotsteam/
/addons/godotsteam*/

# ── Éditeurs ──────────────────────────────────────────────────────────────
.vs/
.idea/
*.swp
*.user

# ── Système ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Secrets ───────────────────────────────────────────────────────────────
# Clés Steam, credentials d'export, certificats de signature.
export_presets.cfg
*.env
.env.local
steam_appid.txt
