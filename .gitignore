# ── Godot 4 ───────────────────────────────────────────────────────────────
# Cache et données locales du moteur : régénérés à l'ouverture du projet.
.godot/
/android/

# Anciennes versions de Godot (3.x) — inoffensif de le garder.
.import/

# ── Exports & builds ──────────────────────────────────────────────────────
/build/
/builds/
/exports/
*.pck
*.zip

# ── .NET / C# ─────────────────────────────────────────────────────────────
# Godot régénère le .csproj et le .sln, mais on les VERSIONNE quand même :
# ils portent les références de packages. Seuls les artefacts sont ignorés.
bin/
obj/
*.user
.vs/
.idea/
*.swp

# ── Système ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Secrets ───────────────────────────────────────────────────────────────
# Clés Steam, credentials d'export, certificats de signature.
export_presets.cfg
*.env
.env.local
steam_appid.txt
